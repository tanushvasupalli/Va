# ============================================================
# WEDNESDAY AI - ENVIRONMENT CONFIGURATION
# ============================================================

# 1. AI API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud Database (for persistent memory & conversation sessions)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DATABASE_URL=

# 3. Telegram Bot Control & Interface
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your numeric User ID from @userinfobot (restricts bot access to you only)
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id

# 4. n8n Automation & Workflows
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/wednesday
N8N_API_KEY=your_n8n_api_key_optional

# 5. Model Context Protocol (MCP) Servers
# Comma-separated list of MCP server URLs (e.g. http://localhost:8000/sse, http://192.168.1.50:8001/sse)
MCP_SERVERS=

# 6. Remote PC Access Bridge (runs on Windows PC)
# Use Tailscale IP (e.g. http://100.x.y.z:8085) or local LAN IP (e.g. http://192.168.1.15:8085)
PC_AGENT_URL=http://localhost:8085
PC_AGENT_KEY=wednesday_pc_secret

# 7. Local Network & Device Management
LOCAL_SUBNET=192.168.1.0/24
PC_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# 8. Audio & Output Control
MUTE_AGENT_VOICE=false
PLAY_CHIMES=true
OUTPUT_DEVICE_INDEX=
