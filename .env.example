# Free API Keys
# 1. Groq API Key (from https://console.groq.com/keys) - used for ultra-fast Whisper STT
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key (from https://aistudio.google.com/) - used for Wednesday's Brain
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Supabase Cloud Database
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# 4. Voice & Audio Output Control
MUTE_AGENT_VOICE=false
PLAY_CHIMES=true
OUTPUT_DEVICE_INDEX=

